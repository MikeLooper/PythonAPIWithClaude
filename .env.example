# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Anthropic / Claude ---------------------------------------------------
# Read directly by the Anthropic SDK.
ANTHROPIC_API_KEY=sk-ant-...

CLAUDE_MODEL=claude-opus-5-5
CLAUDE_MAX_TOKENS=16000
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
CLAUDE_TIMEOUT_SECONDS=120
CLAUDE_MAX_RETRIES=2
CLAUDE_REFUSAL_FALLBACK=true
# CLAUDE_SYSTEM_PROMPT="You are a helpful assistant..."

# --- Server ------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=56601
LOG_LEVEL=INFO

# --- OpenTelemetry -----------------------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=python-api-with-claude
# gRPC (default): http://localhost:4317   |   HTTP: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# grpc | http/protobuf
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
